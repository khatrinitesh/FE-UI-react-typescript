import { createFileRoute } from '@tanstack/react-router'

export const Route = createFileRoute('/product-details')({
  component: RouteComponent,
})

function RouteComponent() {
  const { id } = Route.useParams()

  return (
    <div>
      <h1>Product Details Page</h1>
      <p>Product ID: {id}</p>
    </div>
  )
}